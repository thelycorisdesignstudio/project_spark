# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB_NAME=spark

# JWT
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Stripe
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_FAMILY_PRICE_ID=price_xxx

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=xxx
AZURE_STORAGE_CONTAINER_AVATARS=avatars
AZURE_STORAGE_CONTAINER_THUMBNAILS=thumbnails

# SMTP Email Configuration
SMTP_HOST=smtp.azurecomm.net
SMTP_PORT=587
SMTP_USER=your-smtp-username-here
SMTP_PASS=your-smtp-password-here
EMAIL_FROM=hello@sparkcoding.app

# Azure Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx

# Client
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
PORT=8080
